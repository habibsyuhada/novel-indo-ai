# Database
DATABASE_URL=postgres://user:password@localhost:5432/bacanovelindo

# Session
JWT_SECRET=change-me-to-a-long-random-string

# Public base URL, used to build links inside emails
APP_URL=https://bacanovelindo.click

# Cloudflare Turnstile (anti-bot) - https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Resend (email delivery) - https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM="Baca Novel Indo <noreply@bacanovelindo.click>"

# Public storage base URL (novel covers & chapter illustrations)
NEXT_PUBLIC_STORAGE_URL=https://storage.bacanovelindo.casa
